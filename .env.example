# woolroom environment — copy to .env and fill in. Every key maps to a field
# in app/config.py; shown values are the safe defaults.

# Utterance lane: "disabled" (phrasebook only), "anthropic" (metered API key —
# in prod only sk-ant-api... keys are accepted; subscription/OAuth credentials
# are refused at boot), or "ollama" (self-hosted).
LLM_PROVIDER=disabled
# ANTHROPIC_API_KEY=sk-ant-api...
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MAX_TOKENS=80
# LLM_TIMEOUT_S=8.0
# LLM_DAILY_CALL_CAP=50
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

SECRET_KEY=generate-a-random-string-here
# Outer site-access gate; empty = open site (dev default).
SITE_PASSWORD=
SITE_ACCESS_DAYS=60
DATABASE_URL=sqlite+aiosqlite:///./woolroom.db
# Empty = derive from each request; set when behind a proxy.
BASE_URL=
LOG_LEVEL=info
# The room's home timezone: drives the diurnal mood curve, day-keyed
# facts/quirks, and the local hour the daily cron jobs fire at. Any IANA
# name works; UTC is the neutral default.
HOME_TZ=UTC
ENV=dev

# Daily outing cron local hour, memory caps.
# DAILY_OUTING_HOUR=9
# MOOD_DRIFT_INTERVAL_MINUTES=15
# BUFFER_MAX_EVENTS=50
# MOMENTS_MAX_PER_YEAR=52

# Adoption gate: comma-separated user ids allowed to adopt (empty = anyone).
# ADOPT_ALLOWLIST=

# Content packs (pack format v1): comma-separated local directories, loaded
# and registered at boot. The repo ships one example: packs/pebble.
# PACK_PATHS=packs/pebble

# Household shape — pair-shaped BY DESIGN; HOUSEHOLD_SIZE must stay 2.
# HOUSEHOLD_SIZE=2
# MAX_ROOMS_PER_HOUSEHOLD=2
# QUIRK_PICK_COUNT=2

# Read-only guest mode: a signed cookie lets visitors watch one pinned demo
# pet (REST + WS, private fields stripped). Seed the demo pet with
# scripts/seed_demo_pet.py and pin its id here. Empty = first pet (dev only).
# GUEST_ACCESS_ENABLED=false
# GUEST_PET_ID=

# Shared secret for /admin/* endpoints. Empty disables admin entirely.
# ADMIN_TOKEN=

# If true, /api/start mints a fresh user without an invite cookie. Keep off
# in production — invite-only signup avoids duplicate-account accidents.
# OPEN_SIGNUP=false
